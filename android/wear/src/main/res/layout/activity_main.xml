<?xml version="1.0" encoding="utf-8"?>
<!-- BoxInsetLayout keeps content inside the square inscribed in the round display;
     the ScrollView guarantees the toggle stays reachable even when the status text
     wraps to several lines. -->
<androidx.wear.widget.BoxInsetLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:boxedEdges="all">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/txt_bpm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bpm_placeholder"
                android:textColor="#EF5350"
                android:textSize="40sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bpm"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/status_idle"
                android:textColor="#C9D1D9"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_subscribers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/subscribers_none"
                android:textColor="#8B949E"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="130dp"
                android:minHeight="44dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:text="@string/btn_start" />

        </LinearLayout>
    </ScrollView>
</androidx.wear.widget.BoxInsetLayout>
